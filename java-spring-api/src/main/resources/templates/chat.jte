@import java.util.List
@param List<String> skills
<!doctype html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Command — Faceless Studio</title>
    <style>
        :root { color-scheme: dark; --bg:#050505; --surface:#0d0d0e; --surface-2:#141415; --surface-3:#1b1b1d; --line:#29292c; --text:#f5f5f5; --muted:#8f9097; --faint:#5d5e64; --accent:#fff; --accent-text:#080808; --user:#f5f5f5; --user-text:#090909; --assistant:#171719; --shadow:0 28px 90px #000b; }
        [data-theme="light"] { color-scheme:light; --bg:#f2f3f5; --surface:#fff; --surface-2:#f7f7f8; --surface-3:#ececef; --line:#dedee3; --text:#111114; --muted:#71727a; --faint:#a1a2a8; --accent:#111114; --accent-text:#fff; --user:#111114; --user-text:#fff; --assistant:#e9e9ed; --shadow:0 28px 80px #20242f18; }
        * { box-sizing:border-box; } html,body { margin:0; min-height:100%; } body { min-height:100vh; background:var(--bg); color:var(--text); font:14px/1.55 Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
        button,textarea { font:inherit; } button { cursor:pointer; }
        .app { height:100vh; padding:18px; display:grid; grid-template-columns:290px minmax(0,1fr); gap:14px; max-width:1440px; margin:auto; }
        .sidebar,.conversation { border:1px solid var(--line); background:var(--surface); box-shadow:var(--shadow); border-radius:22px; min-height:0; }
        .sidebar { padding:18px 14px 14px; display:flex; flex-direction:column; overflow:hidden; animation:rise .55s ease both; }
        .brand { display:flex; align-items:center; gap:11px; padding:5px 9px 22px; font-weight:750; letter-spacing:-.03em; font-size:16px; }
        .logo { width:34px; height:34px; display:grid; place-items:center; background:var(--accent); color:var(--accent-text); border-radius:11px; font-size:17px; box-shadow:0 0 0 5px color-mix(in srgb,var(--accent) 10%,transparent); }
        .new-chat { width:100%; display:flex; align-items:center; gap:10px; border:1px solid var(--line); background:var(--surface-2); color:var(--text); border-radius:12px; padding:11px 13px; font-weight:650; transition:transform .2s,background .2s,border-color .2s; }
        .new-chat:hover { transform:translateY(-2px); background:var(--surface-3); border-color:var(--faint); } .plus { font-size:20px; font-weight:300; line-height:12px; }
        .section-label { margin:25px 9px 9px; color:var(--faint); font-size:10px; font-weight:750; letter-spacing:.14em; text-transform:uppercase; }
        .conversation-list { min-height:0; overflow:auto; display:flex; flex-direction:column; gap:3px; } .conversation-item { position:relative; border:1px solid transparent; background:transparent; color:var(--muted); text-align:left; border-radius:10px; padding:10px 12px; transition:all .2s; overflow:hidden; }
        .conversation-item:hover { background:var(--surface-2); color:var(--text); } .conversation-item.active { background:var(--surface-3); color:var(--text); border-color:var(--line); } .conversation-item.active:before { content:""; position:absolute; left:0; top:10px; bottom:10px; width:2px; background:var(--accent); border-radius:3px; }
        .conversation-title { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-weight:600; } .conversation-time { display:block; color:var(--faint); font-size:11px; margin-top:2px; }
        .sidebar-footer { margin-top:auto; padding-top:16px; border-top:1px solid var(--line); display:flex; align-items:center; justify-content:space-between; color:var(--muted); font-size:12px; } .theme-toggle { border:1px solid var(--line); background:var(--surface-2); color:var(--text); border-radius:9px; padding:7px 9px; transition:transform .2s; } .theme-toggle:hover { transform:rotate(-4deg); }
        .conversation { display:flex; flex-direction:column; overflow:hidden; animation:rise .55s .08s ease both; }
        .topbar { min-height:78px; padding:17px 25px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--line); } .title-wrap { min-width:0; } h1 { margin:0; font-size:18px; letter-spacing:-.035em; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; } .subtitle { color:var(--muted); font-size:12px; display:flex; align-items:center; gap:7px; margin-top:3px; } .online { width:6px; height:6px; border-radius:50%; background:#7ee787; box-shadow:0 0 0 4px #7ee7871c; }
        .top-actions { display:flex; gap:8px; } .icon-btn { width:36px; height:36px; border:1px solid var(--line); border-radius:10px; display:grid; place-items:center; background:var(--surface-2); color:var(--text); transition:all .2s; } .icon-btn:hover { background:var(--surface-3); transform:translateY(-2px); }
        #messages { flex:1; min-height:0; overflow-y:auto; padding:28px clamp(18px,5vw,76px) 24px; display:flex; flex-direction:column; justify-content:flex-start; gap:13px; scroll-behavior:smooth; }
        .welcome { margin:auto; max-width:470px; text-align:center; color:var(--muted); animation:fade .6s ease both; } .welcome-mark { width:50px; height:50px; margin:0 auto 17px; display:grid; place-items:center; border:1px solid var(--line); border-radius:16px; background:var(--surface-2); color:var(--text); font-size:22px; } .welcome strong { display:block; color:var(--text); font-size:29px; letter-spacing:-.06em; margin-bottom:8px; }
        .message-row { display:flex; width:100%; animation:message-in .32s ease both; } .message-row.user { justify-content:flex-end; } .message { max-width:min(720px,82%); padding:12px 16px; border-radius:17px; white-space:pre-wrap; overflow-wrap:anywhere; } .message-row.assistant .message { background:var(--assistant); border:1px solid var(--line); border-top-left-radius:5px; } .message-row.user .message { background:var(--user); color:var(--user-text); border-top-right-radius:5px; } .message.final { box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 8%,transparent); } .message-meta { color:var(--faint); font-size:10px; margin:3px 5px 0; } .message-row.user .message-meta { text-align:right; }
        .tool-chips { display:flex; flex-wrap:wrap; gap:7px; margin:0 0 2px 3px; animation:fade .3s ease both; } .tool-chip { border:1px solid var(--line); color:var(--muted); background:var(--surface-2); border-radius:99px; padding:5px 9px; font-size:11px; } .tool-chip.done { color:var(--text); border-color:var(--faint); }
        .composer-wrap { padding:0 clamp(16px,5vw,76px) 22px; } form { position:relative; display:flex; align-items:flex-end; gap:9px; padding:8px 8px 8px 15px; border:1px solid var(--line); border-radius:16px; background:var(--surface-2); box-shadow:0 10px 35px #0000001a; transition:border-color .25s,box-shadow .25s; } form:focus-within { border-color:var(--faint); box-shadow:0 0 0 4px color-mix(in srgb,var(--accent) 8%,transparent); } textarea { flex:1; min-height:40px; max-height:140px; resize:none; border:0; outline:0; background:transparent; color:var(--text); padding:9px 0; } textarea::placeholder { color:var(--faint); } .send { width:40px; height:40px; border:0; border-radius:11px; background:var(--accent); color:var(--accent-text); font-size:18px; transition:transform .2s,opacity .2s; } .send:hover:not(:disabled) { transform:scale(1.06) rotate(-3deg); } .send:disabled { opacity:.45; cursor:wait; } .composer-note { color:var(--faint); font-size:10px; text-align:center; margin-top:8px; }
        @keyframes rise { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:none; } } @keyframes fade { from { opacity:0; } to { opacity:1; } } @keyframes message-in { from { opacity:0; transform:translateY(8px) scale(.99); } to { opacity:1; transform:none; } }
        @media(max-width:800px) { .app { height:100vh; padding:8px; display:block; } .sidebar { height:auto; max-height:190px; margin-bottom:8px; border-radius:17px; padding:11px; } .brand { padding:3px 5px 11px; } .sidebar .new-chat { position:absolute; right:20px; top:19px; width:auto; padding:9px 11px; font-size:0; } .sidebar .new-chat .plus { font-size:22px; } .section-label { margin:8px 5px 6px; } .conversation-list { flex-direction:row; overflow-x:auto; } .conversation-item { min-width:180px; } .sidebar-footer { display:none; } .conversation { height:calc(100vh - 206px); border-radius:17px; } .topbar { min-height:68px; padding:13px 16px; } #messages { padding:20px 14px 16px; } .composer-wrap { padding:0 12px 12px; } .message { max-width:90%; } }
    </style>
</head>
<body>
<main class="app">
    <aside class="sidebar">
        <div class="brand"><span class="logo">✦</span><span>Faceless Studio</span></div>
        <button class="new-chat" id="new-chat" type="button"><span class="plus">＋</span><span>New conversation</span></button>
        <p class="section-label">Recent conversations</p>
        <nav id="conversation-list" class="conversation-list" aria-label="Previous conversations"></nav>
        <div class="sidebar-footer"><span>Studio copilot</span><button class="theme-toggle" id="theme" type="button">☼</button></div>
    </aside>
    <section class="conversation">
        <header class="topbar"><div class="title-wrap"><h1 id="conversation-title">New conversation</h1><span class="subtitle"><i class="online"></i><span id="state">Ready when you are</span></span></div><div class="top-actions"><button class="icon-btn" id="header-new" type="button" title="New conversation">＋</button><button class="icon-btn" id="header-theme" type="button" title="Toggle theme">◐</button></div></header>
        <div id="messages"><div class="welcome"><div class="welcome-mark">✦</div><strong>What are we making?</strong>Describe your next short, ask for a plan, or let the studio copilot turn an idea into momentum.</div></div>
        <div class="composer-wrap"><form id="composer"><textarea id="prompt" rows="1" placeholder="Message your studio copilot…" required></textarea><button class="send" id="send" type="submit" aria-label="Send message">↑</button></form><div class="composer-note">Enter to send · Shift + Enter for a new line</div></div>
    </section>
</main>
<script>
const root=document.documentElement, messages=document.querySelector('#messages'), prompt=document.querySelector('#prompt'), send=document.querySelector('#send'), state=document.querySelector('#state'), list=document.querySelector('#conversation-list');
const STORE='faceless-studio-conversations', THEME='faceless-studio-theme'; let conversations=JSON.parse(localStorage.getItem(STORE)||'[]'), activeId=null;
const id=()=>crypto.randomUUID(); const now=()=>new Date().toLocaleDateString(undefined,{month:'short',day:'numeric'});
function save(){localStorage.setItem(STORE,JSON.stringify(conversations));} function active(){return conversations.find(x=>x.id===activeId);}
function createConversation(){const chat={id:id(),title:'New conversation',date:now(),messages:[]};conversations.unshift(chat);activeId=chat.id;save();renderList();renderMessages();document.querySelector('#conversation-title').textContent=chat.title;prompt.focus();}
function renderList(){list.innerHTML='';conversations.forEach(chat=>{const button=document.createElement('button');button.className='conversation-item'+(chat.id===activeId?' active':'');button.innerHTML='<span class="conversation-title"></span><span class="conversation-time"></span>';button.querySelector('.conversation-title').textContent=chat.title;button.querySelector('.conversation-time').textContent=chat.date;button.onclick=()=>{activeId=chat.id;renderList();renderMessages();};list.append(button);});}
function addMessage(text,kind,saveIt=true){const row=document.createElement('div');row.className='message-row '+kind;const bubble=document.createElement('div');bubble.className='message';bubble.textContent=text;row.append(bubble);messages.append(row);messages.scrollTop=messages.scrollHeight;if(saveIt){active().messages.push({text,kind});save();}return bubble;}
function renderMessages(){const chat=active();messages.innerHTML='';if(!chat||!chat.messages.length){messages.innerHTML='<div class="welcome"><div class="welcome-mark">✦</div><strong>What are we making?</strong>Describe your next short, ask for a plan, or let the studio copilot turn an idea into momentum.</div>';return;}chat.messages.forEach(m=>addMessage(m.text,m.kind,false));messages.scrollTop=messages.scrollHeight;document.querySelector('#conversation-title').textContent=chat.title;}
function chip(raw){const data=JSON.parse(raw), group=document.querySelector('.tool-chips:last-of-type')||(()=>{const x=document.createElement('div');x.className='tool-chips';messages.append(x);return x;})();const el=document.createElement('span');el.className='tool-chip '+(data.phase==='COMPLETED'?'done':'');el.dataset.toolId=data.id;el.textContent=(data.phase==='COMPLETED'?'✓ ':'⚙ ')+data.name+(data.phase==='COMPLETED'?' complete':' running…');const old=group.querySelector('[data-tool-id="'+data.id+'"]');if(old)old.replaceWith(el);else group.append(el);messages.scrollTop=messages.scrollHeight;}
function newChat(){if(active()&&!active().messages.length&&conversations.length>1)return;createConversation();}
function setTheme(theme){root.dataset.theme=theme;localStorage.setItem(THEME,theme);document.querySelector('#theme').textContent=theme==='dark'?'☼':'☾';}
setTheme(localStorage.getItem(THEME)||'dark');if(!conversations.length)createConversation();else{activeId=conversations[0].id;renderList();renderMessages();}
document.querySelector('#new-chat').onclick=newChat;document.querySelector('#header-new').onclick=newChat;document.querySelector('#theme').onclick=()=>setTheme(root.dataset.theme==='dark'?'light':'dark');document.querySelector('#header-theme').onclick=()=>setTheme(root.dataset.theme==='dark'?'light':'dark');
prompt.addEventListener('input',()=>{prompt.style.height='auto';prompt.style.height=Math.min(prompt.scrollHeight,140)+'px'});prompt.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();document.querySelector('#composer').requestSubmit();}});
document.querySelector('#composer').onsubmit=async e=>{e.preventDefault();const text=prompt.value.trim(),chat=active();if(!text||!chat)return;if(chat.title==='New conversation'){chat.title=text.length>36?text.slice(0,36)+'…':text;document.querySelector('#conversation-title').textContent=chat.title;renderList();}addMessage(text,'user');prompt.value='';prompt.style.height='auto';send.disabled=true;state.textContent='Thinking…';const answer=addMessage('','assistant',false);let answerText='';
try{const res=await fetch('/chat',{method:'POST',headers:{'Content-Type':'application/json','Accept':'text/event-stream'},body:JSON.stringify({message:text,sessionId:chat.id})});if(!res.ok)throw Error('Request failed ('+res.status+')');const reader=res.body.getReader(),decoder=new TextDecoder();let buf='';while(true){const {value,done}=await reader.read();if(done)break;buf+=decoder.decode(value,{stream:true});const chunks=buf.split('\n\n');buf=chunks.pop();for(const chunk of chunks){const type=(chunk.match(/^event:\s*(.*)$/m)||[])[1]||'message',line=chunk.split('\n').find(x=>x.startsWith('data:'));if(!line)continue;const raw=line.slice(5).trim();if(type==='token'){const token=JSON.parse(raw);answerText+=token;answer.textContent=answerText;}else if(type==='tool')chip(raw);else if(type==='error')answer.textContent='I couldn’t complete that request. '+raw;else if(type==='done'){answer.classList.add('final');state.textContent='Ready when you are';}}messages.scrollTop=messages.scrollHeight;}if(answerText){chat.messages.push({text:answerText,kind:'assistant'});save();}}catch(err){answer.textContent='I couldn’t complete that request. '+err.message;state.textContent='Connection unavailable';}finally{send.disabled=false;prompt.focus();}}
</script>
</body>
</html>